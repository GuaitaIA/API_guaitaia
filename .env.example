# .env.example
# Database Configuration
SQLALCHEMY_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/guaitaia
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=guaitaia
DB_HOST=localhost
DB_PORT=5433

# Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=100

# AI Model
MODELO=./model/guaitaia2.onnx

# Image Processing
WEBP_QUALITY=90

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=GuaitaIA
